---
import { Layers } from '@lucide/astro';
import { projects } from '../data/cv';
---

<section class="section" id="proyectos">
  <div class="section-head reveal">
    <p class="kicker">
      <Layers size={16} stroke-width={2} />
      <span data-i18n="projects.kicker">Proyectos</span>
    </p>
    <h2 data-i18n="projects.title">Productos y sistemas reales</h2>
    <p class="section-lead" data-i18n="projects.lead">
      Capturas de lo que uso y mantengo: obra, gobierno, ERP, pagos y un dispositivo inclusivo.
    </p>
  </div>

  <div class="grid">
    {
      projects.map((project, index) => (
        <article class={`card reveal reveal-delay-${(index % 4) + 1}`}>
          <a
            class="media"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Abrir ${project.title}`}
          >
            <img
              src={project.image}
              alt={project.imageAlt}
              width="700"
              height="450"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="body">
            <div class="card-top">
              <span class="tag">{project.tag}</span>
              <a
                class="card-link"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="projects.open"
              >
                Abrir
              </a>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="stack">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .section {
    position: relative;
    z-index: 1;
    padding: 5.5rem clamp(1.25rem, 4vw, 4rem) 4rem;
  }

  .section-head {
    max-width: 42rem;
    margin-bottom: 2.75rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .section-lead {
    color: var(--muted);
    font-size: var(--text-lead);
    line-height: 1.65;
    max-width: 40rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    overflow: hidden;
    transition: transform 0.35s var(--ease-out), background 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    background: var(--card-bg-strong);
  }

  .media {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s var(--ease-out);
  }

  .card:hover .media img {
    transform: scale(1.03);
  }

  .body {
    padding: 1.2rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .tag {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.22rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent-dim);
  }

  .card-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    transition: color 0.25s ease;
  }

  .card-link:hover {
    color: var(--accent-bright);
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
    letter-spacing: -0.02em;
  }

  .body > p {
    color: var(--muted);
    font-size: var(--text-body);
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stack li {
    font-size: 0.85rem;
    color: var(--text);
    padding: 0.28rem 0.55rem;
    background: var(--chip-bg);
    border-radius: var(--radius-sm);
  }
</style>
