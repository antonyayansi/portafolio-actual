---
const agents = [
  { id: 'ui', label: 'UI/UX', color: '#00ff41' },
  { id: 'data', label: 'Data', color: '#34d399' },
  { id: 'iot', label: 'IoT', color: '#86efac' },
  { id: 'api', label: 'Backend', color: '#22c55e' },
];
---

<div class="studio" aria-hidden="true">
  <div class="studio-glass">
    <div class="chrome">
      <span></span><span></span><span></span>
      <p>mis habilidades</p>
    </div>

    <div class="stage">
      <div class="piece piece-card">
        <div class="skeleton-line w60"></div>
        <div class="skeleton-line w90"></div>
        <div class="skeleton-line w75"></div>
        <div class="piece-btn"></div>
      </div>

      <div class="piece piece-chart">
        <span style="--h: 42%"></span>
        <span style="--h: 68%"></span>
        <span style="--h: 55%"></span>
        <span style="--h: 82%"></span>
        <span style="--h: 48%"></span>
      </div>

      <div class="piece piece-nodes">
        <i class="node n1"></i>
        <i class="node n2"></i>
        <i class="node n3"></i>
        <i class="node n4"></i>
        <svg class="wires" viewBox="0 0 160 100" fill="none">
          <path d="M28 30 C60 30, 60 70, 95 70"></path>
          <path d="M28 30 C70 10, 110 20, 132 38"></path>
          <path d="M95 70 C110 70, 120 55, 132 38"></path>
        </svg>
      </div>

      <div class="piece piece-code">
        <code><i></i>api.get('/obra')</code>
        <code><i></i>await db.query()</code>
        <code><i></i>return ok(data)</code>
      </div>

      {
        agents.map((agent) => (
          <div
            class={`agent agent-${agent.id}`}
            style={`--agent: ${agent.color}`}
          >
            <svg class="arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <!-- Solo la punta de flecha (estilo agente / Figma) -->
              <path class="arrow-fill" d="M1 1 L13 6.2 L7.4 7.9 L5.8 13 Z" />
              <path class="arrow-stroke" d="M1 1 L13 6.2 L7.4 7.9 L5.8 13 Z" />
            </svg>
            <span class="tag">{agent.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .studio {
    position: relative;
    width: min(100%, 440px);
    margin-inline: auto;
    perspective: 900px;
  }

  .studio-glass {
    position: relative;
    border-radius: var(--radius-xl);
    border: none;
    background: var(--card-bg-strong);
    overflow: hidden;
    transform: rotateY(-6deg) rotateX(3deg);
    transition: transform 0.6s var(--ease-out);
  }

  .studio:hover .studio-glass {
    transform: rotateY(-2deg) rotateX(1deg);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    border-bottom: none;
    background: rgba(255, 255, 255, 0.04);
  }

  .chrome span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .chrome span:nth-child(1) {
    background: #fb7185;
  }
  .chrome span:nth-child(2) {
    background: #fbbf24;
  }
  .chrome span:nth-child(3) {
    background: #34d399;
  }

  .chrome p {
    margin-left: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stage {
    position: relative;
    height: clamp(300px, 44vh, 400px);
    padding: 1.1rem;
  }

  .piece {
    position: absolute;
    border-radius: var(--radius-md);
    border: none;
    background: var(--card-bg);
    opacity: 0;
    transform: scale(0.86) translateY(10px);
  }

  .piece-card {
    top: 10%;
    left: 6%;
    width: 40%;
    padding: 0.9rem;
    animation: build-in 12s var(--ease-out) 0.2s infinite;
  }

  .skeleton-line {
    height: 0.45rem;
    border-radius: var(--radius-pill);
    background: rgba(var(--accent-rgb), 0.22);
    margin-bottom: 0.45rem;
  }

  .w60 {
    width: 60%;
  }
  .w90 {
    width: 90%;
  }
  .w75 {
    width: 75%;
  }

  .piece-btn {
    margin-top: 0.65rem;
    height: 1.55rem;
    width: 55%;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--accent), var(--accent-bright));
    animation: pulse-soft 2.4s ease-in-out infinite;
  }

  .piece-chart {
    top: 12%;
    right: 6%;
    width: 38%;
    height: 32%;
    display: flex;
    align-items: flex-end;
    gap: 0.35rem;
    padding: 0.75rem;
    animation: build-in 12s var(--ease-out) 3s infinite;
  }

  .piece-chart span {
    flex: 1;
    height: var(--h);
    border-radius: 0.55rem 0.55rem 0.35rem 0.35rem;
    background: linear-gradient(180deg, var(--accent-bright), rgba(var(--accent-rgb), 0.35));
    transform-origin: bottom;
    animation: bar-grow 12s var(--ease-out) 3.2s infinite;
  }

  .piece-nodes {
    left: 8%;
    bottom: 10%;
    width: 42%;
    height: 32%;
    animation: build-in 12s var(--ease-out) 6s infinite;
  }

  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wires path {
    stroke: rgba(var(--accent-rgb), 0.55);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 120;
    animation: dash 12s linear 6.2s infinite;
  }

  .node {
    position: absolute;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--accent-bright);
    box-shadow: none;
  }

  .n1 {
    top: 22%;
    left: 12%;
  }
  .n2 {
    top: 62%;
    left: 52%;
  }
  .n3 {
    top: 30%;
    right: 12%;
  }
  .n4 {
    bottom: 16%;
    left: 28%;
    background: #8b5cf6;
  }

  .piece-code {
    right: 6%;
    bottom: 10%;
    width: 40%;
    padding: 0.75rem;
    display: grid;
    gap: 0.35rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    animation: build-in 12s var(--ease-out) 8.5s infinite;
  }

  .piece-code code {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.62rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
  }

  .piece-code i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* —— Agent cursors (Figma-style) —— */
  .agent {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: max-content;
    pointer-events: none;
    filter: drop-shadow(0 8px 14px rgba(15, 23, 42, 0.28));
    will-change: left, top;
  }

  .arrow {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .arrow-fill {
    fill: var(--agent);
  }

  .arrow-stroke {
    fill: none;
    stroke: #fff;
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .tag {
    margin-top: -0.15rem;
    margin-left: 0.95rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--agent);
    border: none;
    box-shadow: none;
    white-space: nowrap;
  }

  /* left/top % = relative to .stage — cursors stay apart */
  .agent-ui {
    animation: path-ui 12s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
  }
  .agent-data {
    animation: path-data 12s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
  }
  .agent-iot {
    animation: path-iot 12s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
  }
  .agent-api {
    animation: path-api 12s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
  }

  @keyframes path-ui {
    0% {
      left: 4%;
      top: 78%;
    }
    12% {
      left: 14%;
      top: 18%;
    }
    28% {
      left: 22%;
      top: 26%;
    }
    45% {
      left: 18%;
      top: 34%;
    }
    65% {
      left: 28%;
      top: 22%;
    }
    82% {
      left: 12%;
      top: 40%;
    }
    100% {
      left: 4%;
      top: 78%;
    }
  }

  @keyframes path-data {
    0% {
      left: 88%;
      top: 8%;
    }
    15% {
      left: 62%;
      top: 16%;
    }
    32% {
      left: 70%;
      top: 28%;
    }
    50% {
      left: 58%;
      top: 22%;
    }
    70% {
      left: 74%;
      top: 36%;
    }
    88% {
      left: 66%;
      top: 14%;
    }
    100% {
      left: 88%;
      top: 8%;
    }
  }

  @keyframes path-iot {
    0% {
      left: 6%;
      top: 6%;
    }
    18% {
      left: 16%;
      top: 58%;
    }
    36% {
      left: 28%;
      top: 68%;
    }
    55% {
      left: 20%;
      top: 62%;
    }
    74% {
      left: 34%;
      top: 72%;
    }
    90% {
      left: 12%;
      top: 54%;
    }
    100% {
      left: 6%;
      top: 6%;
    }
  }

  @keyframes path-api {
    0% {
      left: 82%;
      top: 82%;
    }
    16% {
      left: 58%;
      top: 62%;
    }
    34% {
      left: 68%;
      top: 72%;
    }
    52% {
      left: 54%;
      top: 66%;
    }
    72% {
      left: 72%;
      top: 58%;
    }
    90% {
      left: 60%;
      top: 76%;
    }
    100% {
      left: 82%;
      top: 82%;
    }
  }

  @keyframes build-in {
    0%,
    6% {
      opacity: 0;
      transform: scale(0.86) translateY(12px);
    }
    14%,
    78% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    90%,
    100% {
      opacity: 0;
      transform: scale(0.92) translateY(-6px);
    }
  }

  @keyframes bar-grow {
    0%,
    8% {
      transform: scaleY(0.15);
    }
    20%,
    78% {
      transform: scaleY(1);
    }
    90%,
    100% {
      transform: scaleY(0.2);
    }
  }

  @keyframes dash {
    0%,
    12% {
      stroke-dashoffset: 120;
    }
    28%,
    78% {
      stroke-dashoffset: 0;
    }
    95%,
    100% {
      stroke-dashoffset: -40;
      opacity: 0.2;
    }
  }

  @keyframes pulse-soft {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.15);
    }
  }

  @media (max-width: 980px) {
    .studio {
      width: min(100%, 360px);
    }

    .studio-glass {
      transform: none;
    }

    .stage {
      height: clamp(260px, 38vh, 320px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .piece,
    .piece-chart span,
    .wires path,
    .piece-btn,
    .agent {
      animation: none !important;
    }

    .piece {
      opacity: 1;
      transform: none;
    }

    .agent-ui {
      left: 18%;
      top: 24%;
    }
    .agent-data {
      left: 64%;
      top: 18%;
    }
    .agent-iot {
      left: 20%;
      top: 62%;
    }
    .agent-api {
      left: 62%;
      top: 66%;
    }
  }
</style>
